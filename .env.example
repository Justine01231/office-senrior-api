# Office of Seniors API - Environment Variables
# Copy this file to .env and fill in your actual values

# JWT Configuration (REQUIRED)
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (REQUIRED)
# For production (Neon.tech):
DATABASE_URL=postgresql://neondb_owner:npg_pzWl0hVNkiU4@ep-tiny-darkness-a1r56s6k-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# For development:
# DATABASE_URL=postgresql://username:password@host:port/database

# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

